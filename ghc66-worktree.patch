diff --git a/ghc622/shims/Directory.hs b/ghc622/shims/Directory.hs
index 65f980b..5f5d9da 100644
--- a/ghc622/shims/Directory.hs
+++ b/ghc622/shims/Directory.hs
@@ -1,11 +1,18 @@
 -- Haskell 98's Directory (ghc622/shims-h98/Directory.hs re-exports MicroHs's
--- System.Directory), plus getModificationTime, which GHC 6.0's --make and
--- recompilation checks use and MicroHs's System.Directory does not provide
--- (it has no stat). Compiling the compiler never calls it; running --make
--- would need a stat primitive in MicroHs.
+-- System.Directory), plus getModificationTime. --make compares source and
+-- object timestamps, so this has to be a real stat(2). The C function is
+-- file_mtime in ghc622/stage1/stubs.c, registered in stage1/ffi.c.
 module Directory(module System.Directory, getModificationTime) where
 import System.Directory
-import Time(ClockTime)
+import Time(ClockTime, clockTimeFromSeconds)
+import Foreign.C.String(CString, withCString)
+import Foreign.C.Types(CLong)
+
+foreign import ccall "file_mtime" c_file_mtime :: CString -> IO CLong
 
 getModificationTime :: FilePath -> IO ClockTime
-getModificationTime _ = ioError (userError "getModificationTime: no stat in MicroHs")
+getModificationTime path = do
+  n <- withCString path c_file_mtime
+  if n < 0
+    then ioError (userError ("getModificationTime: cannot stat " ++ path))
+    else return (clockTimeFromSeconds (toInteger n))

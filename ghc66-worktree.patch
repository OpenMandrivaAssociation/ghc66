diff --git a/ghc622/tools/probe-ordered.sh b/ghc622/tools/probe-ordered.sh
index 958cfb3..808c161 100644
--- a/ghc622/tools/probe-ordered.sh
+++ b/ghc622/tools/probe-ordered.sh
@@ -64,15 +64,24 @@ while read -r m; do
   # A crash mid-write (e.g. a stack overflow) leaves .mhscache truncated and
   # every later module fails with "Bad LZMA signature". Keep a copy of the last
   # good cache and fall back to it once, so one crash cannot void the run.
-  case "$out" in *"Bad LZMA signature"*)
-    if [ -f .mhscache.good ]; then cp .mhscache.good .mhscache
+  # A killed or crashed mhs can leave .mhscache empty or truncated.
+  # "Bad LZMA" and "end of file" are that corruption, not a module error.
+  case "$out" in
+  *"Bad LZMA signature"*|*"end of file"*|*"hGetChar"*)
+    if [ -f .mhscache.good ]; then
+      cp .mhscache.good .mhscache
       raw=$(timeout "${MODTIMEOUT:-180}" "$M/bin/mhs" ${MHSRTS:-+RTS -K20M -RTS} -C -c -XCPP $HSCPP -DOMIT_NATIVE_CODEGEN $DEFS $INC "$m" 2>&1); rc=$?
       out=$(printf '%s' "$raw" | tr '\n' ' ')
     fi ;;
   esac
   case "$rc" in
     0)   printf 'OK\t%s\t\n' "$m" >> "$OUT"; cp .mhscache .mhscache.good 2>/dev/null ;;
-    124) printf 'TIMEOUT\t%s\tkilled after ${MODTIMEOUT:-180}s\n' "$m" >> "$OUT" ;;
+    124)
+      printf 'TIMEOUT\t%s\tkilled after %ss\n' "$m" "${MODTIMEOUT:-180}" >> "$OUT"
+      # timeout can truncate the cache mid-write. Put the last good copy back
+      # before the next module so one slow file does not fail the rest.
+      if [ -f .mhscache.good ]; then cp .mhscache.good .mhscache; fi
+      ;;
     *) printf 'FAIL\t%s\t%s\n' "$m" \
          "$(printf '%s' "$out" | sed 's|.*uncaught exception: ||' | cut -c1-240)" >> "$OUT" ;;
   esac

